<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script>
        tailwind = { config: { corePlugins: { preflight: false } } };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebShop.styles.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-[radial-gradient(circle_at_top_left,_#4c1d95_0%,_#1e1b4b_35%,_#0b1022_100%)] text-white" style="font-family: 'Sora', sans-serif;" data-path="@Context.Request.Path">
    <header class="border-b border-white/10 bg-slate-950/70 backdrop-blur-xl">
        <nav class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4">
            <div class="flex items-center gap-2">
                <span class="text-xl">🛍️</span>
                <a class="text-lg font-semibold tracking-tight text-white" asp-area="" asp-page="/Index">WebShop</a>
            </div>

            <div class="flex items-center gap-4 text-sm font-medium">
                <a class="rounded-xl px-3 py-2 text-white/80 transition hover:bg-white/10 hover:text-white" asp-area="" asp-page="/Index">Home</a>
                <a class="rounded-xl px-3 py-2 text-white/80 transition hover:bg-white/10 hover:text-white" asp-area="" asp-page="/Products/Index">Products</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="rounded-xl px-3 py-2 text-white/80 transition hover:bg-white/10 hover:text-white" asp-area="" asp-page="/User/Orders">My Orders</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a class="rounded-xl px-3 py-2 text-white/80 transition hover:bg-white/10 hover:text-white" asp-area="" asp-page="/Admin/Products">Admin Products</a>
                    <a class="rounded-xl px-3 py-2 text-white/80 transition hover:bg-white/10 hover:text-white" asp-area="" asp-page="/Admin/Orders">Admin Orders</a>
                    <a class="rounded-xl px-3 py-2 text-white/80 transition hover:bg-white/10 hover:text-white" asp-area="" asp-page="/Admin/Users">Admin Users</a>
                }
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <div id="app-main" class="mx-auto w-full max-w-6xl px-4 py-8">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t border-white/10 bg-slate-950/70 py-4 text-sm text-white/60">
        <div class="mx-auto w-full max-w-6xl px-4">
            &copy; 2026 - WebShop - <a class="underline hover:text-white" asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
