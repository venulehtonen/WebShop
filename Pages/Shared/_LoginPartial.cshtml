@* _LoginPartial.cshtml
   ─────────────────────────────────────────────────────────────────────────
   This partial view renders the Login / Register links (when logged out)
   or the username + Logout button (when logged in).

   It is injected into _Layout.cshtml via:  <partial name="_LoginPartial" />

   @inject SignInManager<IdentityUser>  — checks if the user is logged in
   @inject UserManager<IdentityUser>    — retrieves the current user's info
   ─────────────────────────────────────────────────────────────────────────
*@
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="flex items-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    <li>
        <a class="rounded-xl px-3 py-2 text-white/80 transition hover:bg-white/10 hover:text-white" asp-area="Identity" asp-page="/Account/Manage/Index">
            Hello, @UserManager.GetUserName(User)!
        </a>
    </li>
    <li>
        <form asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
            <button type="submit" class="rounded-xl bg-gradient-to-r from-violet-600 to-fuchsia-600 px-3 py-2 text-white transition hover:from-violet-500 hover:to-fuchsia-500">Logout</button>
        </form>
    </li>
}
else
{
    <li>
        <a class="rounded-xl px-3 py-2 text-white/80 transition hover:bg-white/10 hover:text-white" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li>
        <a class="rounded-xl bg-gradient-to-r from-violet-600 to-fuchsia-600 px-3 py-2 text-white transition hover:from-violet-500 hover:to-fuchsia-500" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
