@page
@model WebShop.Pages.User.OrdersModel
@{
    ViewData["Title"] = "My Orders";
}

<h1 class="mb-5 text-3xl font-bold tracking-tight text-white">My Orders</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mb-4 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-emerald-300">@Model.StatusMessage</div>
}

<div class="mb-6 rounded-3xl border border-violet-500/20 bg-white/5 shadow-sm backdrop-blur">
    <div class="border-b border-white/10 px-5 py-4 text-lg font-semibold text-white">Current Cart</div>
    <div class="p-5">
        @if (Model.CartItems.Count == 0)
        {
            <p class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white/70">Your cart is empty.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-white/10 text-sm text-white/85">
                    <thead>
                        <tr class="text-left text-white/60">
                            <th class="px-3 py-2">Product</th>
                            <th class="px-3 py-2 text-right">Unit</th>
                            <th class="px-3 py-2 text-center">Qty</th>
                            <th class="px-3 py-2 text-right">Total</th>
                            <th class="px-3 py-2 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/10">
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td class="px-3 py-2">@item.Name</td>
                                <td class="px-3 py-2 text-right">@item.UnitPrice.ToString("0.00") kr</td>
                                <td class="px-3 py-2 text-center">@item.Quantity</td>
                                <td class="px-3 py-2 text-right">@item.LineTotal.ToString("0.00") kr</td>
                                <td class="px-3 py-2 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <form method="post" asp-page-handler="DecreaseCartItem" class="inline">
                                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                            <button type="submit" class="rounded-xl border border-white/20 bg-white/5 px-2 py-1 hover:bg-white/10">-</button>
                                        </form>
                                        <form method="post" asp-page-handler="IncreaseCartItem" class="inline">
                                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                            <button type="submit" class="rounded-xl border border-white/20 bg-white/5 px-2 py-1 hover:bg-white/10">+</button>
                                        </form>
                                        <form method="post" asp-page-handler="RemoveCartItem" class="inline">
                                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                            <button type="submit" class="rounded-xl border border-rose-500/35 bg-rose-500/10 px-2 py-1 text-rose-300 hover:bg-rose-500/20">Remove</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mb-4 mt-4 text-right">
                <strong class="text-violet-200">
                    Cart total:
                    @Model.CartItems.Sum(i => i.LineTotal).ToString("0.00") kr
                </strong>
            </div>

            <form method="post" asp-page-handler="CreateOrder">
                <button type="submit" class="rounded-full bg-gradient-to-r from-violet-600 to-fuchsia-600 px-4 py-2.5 font-semibold text-white transition hover:from-violet-500 hover:to-fuchsia-500">Create Order</button>
            </form>
        }
    </div>
</div>

<div class="rounded-3xl border border-violet-500/20 bg-white/5 shadow-sm backdrop-blur">
    <div class="border-b border-white/10 px-5 py-4 text-lg font-semibold text-white">Order History</div>
    <div class="p-5">
        @if (Model.Orders.Count == 0)
        {
            <p class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white/70">No orders yet.</p>
        }
        else
        {
            @foreach (var order in Model.Orders)
            {
                <div class="mb-3 rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="mb-2 flex items-center justify-between">
                        <strong>Order #@order.Id</strong>
                        <span class="text-sm text-white/60">@order.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                    <div class="mb-1">Status: <strong class="text-emerald-300">@order.Status</strong></div>
                    <div class="mb-2">Total: <strong class="text-violet-200">@order.TotalAmount.ToString("0.00") kr</strong></div>
                    <ul class="list-disc pl-6">
                        @foreach (var item in order.Items)
                        {
                            <li>@item.ProductName x @item.Quantity - @item.LineTotal.ToString("0.00") kr</li>
                        }
                    </ul>
                </div>
            }
        }
    </div>
</div>
