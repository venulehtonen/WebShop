@page
@model WebShop.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Admin Users";
}

<h1 class="mb-5 text-3xl font-bold tracking-tight text-white">Admin Users</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mb-4 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-emerald-300">@Model.StatusMessage</div>
}

<div class="rounded-3xl border border-violet-500/20 bg-white/5 p-5 shadow-sm backdrop-blur">
    <h2 class="mb-3 text-xl font-semibold text-white">All Users</h2>

    @if (Model.Users.Count == 0)
    {
        <p class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white/70">No users found.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-white/10 text-sm text-white/85">
                <thead>
                    <tr class="text-left text-white/60">
                        <th class="px-3 py-2">Email</th>
                        <th class="px-3 py-2">Role</th>
                        <th class="px-3 py-2 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/10">
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="px-3 py-2">@user.Email</td>
                            <td class="px-3 py-2">
                                @if (user.IsAdmin)
                                {
                                    <span class="rounded-full bg-violet-500/20 px-2 py-1 text-xs font-medium text-violet-200">Admin</span>
                                }
                                else if (user.IsUser)
                                {
                                    <span class="rounded-full bg-blue-500/20 px-2 py-1 text-xs font-medium text-blue-200">User</span>
                                }
                                else
                                {
                                    <span class="rounded-full bg-amber-500/20 px-2 py-1 text-xs font-medium text-amber-200">No role</span>
                                }
                            </td>
                            <td class="px-3 py-2 text-right">
                                @if (!user.IsAdmin)
                                {
                                    <form method="post" asp-page-handler="MakeAdmin" class="inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="rounded-full bg-gradient-to-r from-violet-600 to-fuchsia-600 px-3 py-1.5 text-white transition hover:from-violet-500 hover:to-fuchsia-500">Make admin</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="RemoveAdmin" class="inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="rounded-full border border-rose-500/35 bg-rose-500/10 px-3 py-1.5 text-rose-300 hover:bg-rose-500/20">Remove admin</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
